# The box as a service on the Pi: starts at boot, restarts if it dies.
#
#   sudo cp deploy/box.service /etc/systemd/system/
#   sudo systemctl enable --now box
#   journalctl -u box -f            # or just open the dashboard's log
#
# Paths assume the repo is checked out at /opt/box; adjust WorkingDirectory
# and the uv path (`which uv`) to match.

[Unit]
Description=box LED display
# Deliberately not After=network-online: the panel should light up even with
# no wifi. Feeds and connectors find it once the network arrives.
After=local-fs.target

[Service]
Type=simple
WorkingDirectory=/opt/box/box
Environment=BOX_DISPLAY_MODE=matrix
# Everything else (panel size, BOX_TOKEN, ...) comes from /opt/box/.env.
# rpi-rgb-led-matrix needs root for its GPIO timing.
User=root
ExecStart=/usr/local/bin/uv run --no-dev --extra pi python -m box
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
